{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "frontend",
  "regions": [
    "icn1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/rules/**,backend/src/schema.sql,content/**}",
      "maxDuration": 15,
      "excludeFiles": "frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
