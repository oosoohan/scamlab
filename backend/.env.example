# 복사해서 backend/.env 로 쓰세요. (.env는 커밋하지 않습니다)

# 서버 포트 (로컬)
PORT=3000

# ── DB ──────────────────────────────────────────────
# 아무것도 안 쓰면 로컬 파일 DB(backend/data/scamlab.db)를 씁니다.
# DB_PATH=./data/scamlab.db
#
# Turso(클라우드 DB)에 붙이려면 아래 두 줄을 채웁니다. 배포 환경에도 같은 이름으로 넣습니다.
# TURSO_DATABASE_URL=libsql://<db이름>-<계정>.turso.io
# TURSO_AUTH_TOKEN=<토큰>

# 프론트를 Live Server 등으로 따로 띄울 때 허용할 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 채점 규칙 버전 (backend/rules/<버전>.json)
SCORING_VERSION=v2

# 설정하면 GET /api/stats/items (문항 통계) 가 열립니다
# ADMIN_TOKEN=

# 직접 답장(AI 채점). 비워 두면 기능이 꺼지고 게임은 선택지로만 진행됩니다.
# 키는 console.anthropic.com 에서 발급 (Claude 구독과 별개, API 크레딧 필요)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-haiku-5-5
# 비용 안전장치: 서버 인스턴스당 1시간에 AI 채점을 이 횟수까지만 (기본 1500)
# AI_HOURLY_CAP=1500
