# 복사해서 backend/.env 로 쓰세요. (.env는 커밋하지 않습니다)

# 서버 포트
PORT=3000

# SQLite 파일 위치 (기본: backend/data/scamlab.db)
# DB_PATH=./data/scamlab.db

# 프론트를 Live Server 등으로 따로 띄울 때 허용할 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# 채점 규칙 버전 (backend/rules/<버전>.json)
SCORING_VERSION=v1

# 설정하면 GET /api/stats/items (문항 통계) 가 열립니다
# ADMIN_TOKEN=
